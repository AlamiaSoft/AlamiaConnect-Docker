# AlamiaConnect Production Environment Configuration
PROJECT_NAME=alamia-prod
APP_PORT=9001
PMA_PORT=8081
DB_PASSWORD=your_secure_prod_password_here

# Backend Repository Configuration
BACKEND_REPO_URL=https://github.com/AlamiaSoft/AlamiaConnect-Backend
BACKEND_REPO_BRANCH=main

# Docker Image (from GHCR after CI/CD runs)
IMAGE_NAME=ghcr.io/alamiasoft/alamia-connect-docker:main

# Application Environment
APP_ENV=production
