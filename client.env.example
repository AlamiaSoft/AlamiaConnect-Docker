# AlamiaConnect Client Environment Configuration (e.g., KTD, Madina Autos)
PROJECT_NAME=alamia-ktd
APP_PORT=9001
PMA_PORT=8081
DB_PASSWORD=your_secure_password_for_this_client

# Backend Repository Configuration
# You can use a specific branch or even a different repository for this client
BACKEND_REPO_URL=https://github.com/AlamiaSoft/AlamiaConnect-Backend
BACKEND_REPO_BRANCH=ktd-main

# Docker Image (from GHCR after CI/CD runs)
IMAGE_NAME=ghcr.io/alamiasoft/alamia-connect-docker:main

# Application Environment
APP_ENV=production
